{
  "name": "trip-streaming-monitor",
  "productName": "TRIP Streaming Monitor",
  "version": "1.1.0",
  "description": "Monitoraggio professionale di flussi streaming live (web radio, web TV) con VU meter, allarmi ON AIR / OFF AIR / SILENZIO e notifiche push.",
  "author": {
    "name": "Massimiliano Mascioli Trippa",
    "email": "max@maxtrip.it"
  },
  "license": "UNLICENSED",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "test": "node test/engine.test.js && node test/sources.test.js && node test/notify.test.js && node test/transfer.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "nodemailer": "^10.1.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "smtp-server": "^3.20.2"
  },
  "build": {
    "appId": "it.maxtrip.streammonitor",
    "productName": "TRIP Streaming Monitor",
    "copyright": "© Massimiliano Mascioli Trippa — max@maxtrip.it",
    "files": [
      "src/**/*",
      "ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "TRIP-Streaming-Monitor-Setup-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "TRIP-Streaming-Monitor-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "TRIP-Streaming-Monitor-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/adhoc-sign.js"
  }
}
